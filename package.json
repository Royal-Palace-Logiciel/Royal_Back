{
  "name": "hda-backend",
  "version": "1.0.0",
  "description": "API backend Node.js/Express pour la base hda (hebergement, restaurant, stock, finance, casino)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "seed": "node Database/seed.js",
    "seed:user": "node Database/seedUser.js",
    "seed:category": "node Database/SeedCategories.js",
    "seed:location": "node Database/seedStockLocation.js",
    "seed:unit": "node Database/seedUnit.js",
    "seed:productType": "node Database/seedProductType.js",
    "seed:ingredients": "node Database/seedRestaurantIngredients.js",
    "seed:refresh": "node Database/seed.js --refresh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.10.0",
    "pdfkit": "^0.13.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
