DROP TABLE IF EXISTS `casino_cashier_sessions`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `casino_cashier_sessions` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `cashier_id` bigint(20) unsigned NOT NULL,
  `user_id` bigint(20) unsigned NOT NULL COMMENT 'Caissier connecté',
  `ouverture_at` datetime NOT NULL,
  `fermeture_at` datetime DEFAULT NULL,
  `fond_initial` bigint(20) unsigned NOT NULL DEFAULT 0,
  `fond_final_declare` bigint(20) unsigned DEFAULT NULL COMMENT 'Comptage physique à la fermeture',
  `fond_final_theorique` bigint(20) DEFAULT NULL COMMENT 'fond_initial + entrées - sorties',
  `ecart` bigint(20) DEFAULT NULL COMMENT 'déclaré - théorique',
  `statut` enum('OUVERTE','FERMEE') NOT NULL DEFAULT 'OUVERTE',
  `commentaire` text DEFAULT NULL,
  `created_at` datetime DEFAULT current_timestamp(),
  `cashier_id_if_open` bigint(20) unsigned GENERATED ALWAYS AS (if(`statut` = 'OUVERTE',`cashier_id`,NULL)) VIRTUAL,
  `cash_check` bigint(20) DEFAULT NULL COMMENT 'Cash check / manque de caisse déclaré à la fermeture',
  `cashing_verifie` tinyint(1) NOT NULL DEFAULT 0 COMMENT 'Validation du montant en espèces par le caissier',
  `cashing_verifie_le` datetime DEFAULT NULL COMMENT 'Date de validation du cashing par le caissier',
  `cashing_verifie_par` bigint(20) unsigned DEFAULT NULL COMMENT 'Caissier qui a validé le montant en caisse',
  `cashing_montant_verifie` bigint(20) DEFAULT NULL COMMENT 'Montant physique en espèces vérifié par le caissier',
  `rack_check_verifie` tinyint(1) NOT NULL DEFAULT 0 COMMENT 'Validation du rack du croupier par le caissier',
  `rack_check_montant` bigint(20) DEFAULT NULL COMMENT 'Montant de jetons présent dans le rack au moment du contrôle',
  `rack_check_manquant` bigint(20) DEFAULT NULL COMMENT 'Manque de jetons constaté dans le rack',
  `rack_check_le` datetime DEFAULT NULL COMMENT 'Date de validation du rack check',
  `rack_check_par` bigint(20) unsigned DEFAULT NULL COMMENT 'Utilisateur qui a validé le rack check',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_one_open_session_per_cashier` (`cashier_id_if_open`),
  KEY `idx_sessions_cashier` (`cashier_id`),
  KEY `idx_sessions_user` (`user_id`),
  KEY `idx_sessions_statut` (`statut`),
  KEY `idx_sessions_cash_check` (`cash_check`),
  KEY `idx_sessions_cashing_verifie` (`cashing_verifie`),
  KEY `idx_sessions_rack_check_verifie` (`rack_check_verifie`),
  KEY `idx_sessions_rack_check_manquant` (`rack_check_manquant`),
