DROP TABLE IF EXISTS `rh_payroll`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `rh_payroll` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `employee_id` bigint(20) unsigned NOT NULL,
  `period_month` date NOT NULL,
  `base_salary` decimal(15,2) NOT NULL DEFAULT 0.00,
  `overtime_amount` decimal(15,2) NOT NULL DEFAULT 0.00,
  `bonuses` decimal(15,2) NOT NULL DEFAULT 0.00,
  `pourboire` decimal(15,2) NOT NULL DEFAULT 0.00,
  `allowances` decimal(15,2) NOT NULL DEFAULT 0.00,
  `advances` decimal(15,2) NOT NULL DEFAULT 0.00,
  `deductions` decimal(15,2) NOT NULL DEFAULT 0.00,
  `deduction_amount` decimal(15,2) NOT NULL DEFAULT 0.00,
  `deduction_frequency` enum('MENSUEL','HEBDOMADAIRE') NOT NULL DEFAULT 'MENSUEL',
  `deduction_reason` varchar(255) DEFAULT NULL,
  `absence_deductions` decimal(15,2) NOT NULL DEFAULT 0.00,
  `cnaps` decimal(15,2) NOT NULL DEFAULT 0.00,
  `ostie` decimal(15,2) NOT NULL DEFAULT 0.00,
  `irsa` decimal(15,2) NOT NULL DEFAULT 0.00,
  `presence_days` int(10) unsigned DEFAULT NULL,
  `net_amount` decimal(15,2) NOT NULL DEFAULT 0.00,
  `status` enum('BROUILLON','VALIDE','PAYE') NOT NULL DEFAULT 'BROUILLON',
  `paid_at` datetime DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_rh_payroll_employee_period` (`employee_id`,`period_month`),
  KEY `idx_rh_payroll_period` (`period_month`),
  CONSTRAINT `fk_rh_payroll_employee_history` FOREIGN KEY (`employee_id`) REFERENCES `rh_employees` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=15 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `rh_payroll` WRITE;
