DROP TABLE IF EXISTS `casino_players`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `casino_players` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `nom` varchar(150) NOT NULL,
  `prenom` varchar(150) DEFAULT NULL,
  `surnom` varchar(150) DEFAULT NULL,
  `telephone` varchar(50) DEFAULT NULL,
  `whatsapp` varchar(50) DEFAULT NULL,
  `whatsapp_fiche_consent` tinyint(1) NOT NULL DEFAULT 0,
  `whatsapp_fiche_consent_signature` mediumtext DEFAULT NULL,
  `whatsapp_fiche_consent_at` datetime DEFAULT NULL,
  `identite_type` varchar(80) DEFAULT NULL,
  `identite_numero` varchar(120) DEFAULT NULL,
  `identite_nom_complet` varchar(255) DEFAULT NULL,
  `identite_date_emission` date DEFAULT NULL,
  `identite_verifiee` tinyint(1) NOT NULL DEFAULT 0,
  `identite_fichier_url` varchar(500) DEFAULT NULL,
  `identite_fichiers_urls` text DEFAULT NULL,
  `email` varchar(190) DEFAULT NULL,
  `date_inscription` date DEFAULT NULL,
  `depot` decimal(15,2) NOT NULL DEFAULT 0.00,
  `credit` decimal(15,2) NOT NULL DEFAULT 0.00,
  `mode_jeu` varchar(100) DEFAULT NULL,
  `statut_jeu` enum('EN_JEU','ARRETE') NOT NULL DEFAULT 'ARRETE',
  `statut` enum('ACTIF','INACTIF') NOT NULL DEFAULT 'ACTIF',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_casino_players_name` (`nom`,`prenom`),
  KEY `idx_casino_players_status` (`statut`)
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `casino_players` WRITE;
/*!40000 ALTER TABLE `casino_players` DISABLE KEYS */;
