  `last_name` varchar(100) NOT NULL,
  `photo_url` varchar(500) DEFAULT NULL,
  `birth_date` date DEFAULT NULL,
  `phone` varchar(40) DEFAULT NULL,
  `address` varchar(255) DEFAULT NULL,
  `email` varchar(190) DEFAULT NULL,
  `identification_number` varchar(100) DEFAULT NULL,
  `department` varchar(120) NOT NULL,
  `position` varchar(160) NOT NULL,
  `qualification` varchar(40) DEFAULT NULL,
  `cnaps_number` varchar(40) DEFAULT NULL,
  `dependents` tinyint(3) unsigned NOT NULL DEFAULT 0,
  `face_consent_at` datetime DEFAULT NULL,
  `joined_at` date NOT NULL,
  `contract_type` varchar(40) NOT NULL DEFAULT 'CDI',
  `contract_end_date` date DEFAULT NULL,
  `salary` decimal(15,2) NOT NULL DEFAULT 0.00,
  `prime` decimal(15,2) NOT NULL DEFAULT 0.00,
  `pourboire` decimal(15,2) NOT NULL DEFAULT 0.00,
